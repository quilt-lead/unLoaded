#!/bin/sh
# Copyright guard on every commit (scans the staged changes of the whole repo: src/, public/, packages/, tools/, ...).
# Install once per clone, from the repo root:
#   git config core.hooksPath tools/calcgraph-reference/scripts/git-hooks
# The guard is stdlib-only Python; any python3 works.
set -e
tools=$(cd "$(dirname "$0")/../.." && pwd)
py="$tools/.venv/bin/python"
[ -x "$py" ] || py=python3

"$py" "$tools/scripts/check_no_copyrighted.py" --staged
