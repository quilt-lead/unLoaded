{
  "name": "@unloaded/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server (stdio) over one structural project: an IFC model mapped to calc-package PDFs by @unloaded/calc-parser and @unloaded/element-graph. The engineer's own AI queries elements, calcs, links, evidence, load path and impact, and records review decisions to an append-only decisions file.",
  "bin": {
    "unloaded-mcp-server": "./bin/unloaded-mcp-server.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "node bin/unloaded-mcp-server.mjs --model ../calc-parser/test/fixtures/model_rev1.ifc --calcs ../calc-parser/test/fixtures/calc_package.pdf --check",
    "parity": "node scripts/mcp-parity.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "0.1.100",
    "@unloaded/calc-parser": "0.1.0",
    "@unloaded/element-graph": "0.1.0",
    "@unloaded/ifc-parser": "0.1.0",
    "pdfjs-dist": "4.10.38",
    "zod": "4.6.7"
  }
}
