# OS / editor
.DS_Store

# frontend (Vite app at the repo root)
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
# web-ifc wasm, copied from node_modules by scripts/copy-assets.mjs on install / dev / build
public/wasm/
# sample files copied by scripts/copy-assets.mjs
public/samples/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# reference tooling's local data: synthetic package, eval output, caches - never committed.
# Only small fixtures and the sources list are tracked.
# tools/calcgraph-reference/data/sets/ and tools/calcgraph-reference/data/labels/ (copyrighted permit set, private hand labels) stay ignored;
# the copyright guard (tools/calcgraph-reference/scripts/check_no_copyrighted.py) also blocks them.
tools/calcgraph-reference/data/*
!tools/calcgraph-reference/data/fixtures/
!tools/calcgraph-reference/data/SOURCES.md
*.sqlite
