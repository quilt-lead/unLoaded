{
  // Type check for calc-graph. CI runs it through scripts/check_types.py (pyright version pinned there).
  // A ratchet, not a clean slate: the committed eval/pyright_baseline.json lists the errors still allowed,
  // a NEW error fails CI, and the baseline only ever shrinks (an entry that no longer occurs fails too). scripts/typecheck_canary.py proves on every run that passing a dict where a pydantic
  // model is required (a410607: inbox -> impact_timeline, AttributeError at runtime) is reported.
  "include": ["backend/calcgraph", "backend/tests", "scripts", "synth"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/generated",
    "backend/calcgraph/recalc_pages_assets",
    ".venv",
    "data",
    "frontend",
    "windows-bridge"
  ],
  "extraPaths": ["backend", "."],
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "reportMissingModuleSource": "none"
}
