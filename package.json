{
  "name": "structural-bim-graph-viewer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run src && npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@unloaded/calc-mapper": "0.1.0",
    "@unloaded/element-graph": "0.1.0",
    "@unloaded/ifc-parser": "0.1.0",
    "@unloaded/project-file": "0.1.0",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "web-ifc": "0.0.66"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^3.0.0"
  }
}
